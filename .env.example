PORT=3000
WORKER_PORT=3001
FRONT_URL=http://localhost

# En el compose: postgres://drive:drive@db:5432/driveclone
DATABASE_URL=postgres://drive:drive@localhost:5433/driveclone

AWS_REGION=us-east-1
# Con el IAM de Terraform: terraform output -raw iam_access_key_id / iam_secret_access_key
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# En el compose: http://localstack:4566
AWS_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=driveclone-storage
SQS_QUEUE_URL=http://localhost:4566/000000000000/driveclone-jobs
SQS_DLQ_URL=http://localhost:4566/000000000000/driveclone-jobs-dlq

# Carpeta compartida por la API y el worker
UPLOAD_TMP_DIR=/data/uploads
# 50 MB, igual que client_max_body_size en NGINX
MAX_UPLOAD_BYTES=52428800
WORKER_CONCURRENCY=4
# Iguales a la configuración de la cola en Terraform
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_MS=10000

# Permite la cabecera x-user-id sin login (solo desarrollo)
ALLOW_DEV_AUTH=false
